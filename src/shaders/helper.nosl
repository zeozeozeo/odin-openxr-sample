Helper_Data :: struct
{
    positions: []vec4,
    model_to_world: mat4,
    world_to_view: mat4,
    view_to_proj: mat4,
    color: vec4,
}

Helper_Out :: struct
{
    pos: vec4 @position,
    color: vec4 @io(0),
}

vert :: #vertex (vert_id: uint @vert_id, data: ^Helper_Data @data) -> Helper_Out
{
    world_pos := data.model_to_world * data.positions[vert_id];
    clip_pos := data.view_to_proj * (data.world_to_view * world_pos);
    clip_pos.y = 0.0 - clip_pos.y;

    out: Helper_Out;
    out.pos = clip_pos;
    out.color = data.color;
    return out;
}

frag :: #fragment (input: Helper_Out) -> vec4 @io(0)
{
    return input.color;
}
